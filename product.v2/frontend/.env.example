# auto  — (по умолчанию, если переменная не задана) при старте проверяется GET /api/health:
#         сервер отвечает — расчёт на сервере, нет — демо-режим в браузере
# http  — все запросы идут на /api (в dev-режиме Vite проксирует их на http://localhost:8000)
# mock  — расчёт и «AI» работают прямо в браузере, сервер не нужен (режим разработки интерфейса)
VITE_API_MODE=http
# Необязательно: другой адрес API (по умолчанию относительный /api)
# VITE_API_BASE=/api
