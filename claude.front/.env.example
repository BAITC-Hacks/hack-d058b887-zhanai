# Public frontend configuration. Never put AI keys or credentials here.
# Default is the real backend. No local .env file is required.
VITE_API_MODE=http

# Keep a relative URL for the Vite dev/preview proxy and production reverse proxy.
VITE_API_BASE=/api

# Explicit local demo: open ?demo=1 or run npm run dev:demo.
# Root .env belongs to the Python backend and stores OPENAI_API_KEY, if used.
