# Скопируйте в .env (./scripts/setup.sh делает это сам). Файл .env не коммитится.

# Ключ OpenAI. Пусто — симулятор работает полностью, AI-пояснение собирается
# из фактов расчёта по шаблону и честно помечено «без AI».
OPENAI_API_KEY=

# Модель для OpenAI Responses API (пояснение и AI-агент). Укажите модель,
# доступную вашему ключу и поддерживающую function calling.
AI_MODEL=gpt-6-sol

# Необязательно: отдельная модель для AI-агента и лимит вызовов инструментов.
# AGENT_MODEL=
# AGENT_MAX_TOOL_CALLS=8

# Правила допустимого плана (одинаковы для всех пользователей сервера):
#   dataset        — ровно 5 разных мер, не больше 2 из одного направления (по датасету)
#   all_directions — дополнительно по одной мере из каждого из 5 направлений
RULESET=dataset

# Источники, которым разрешён CORS (нужно только если UI открыт не через прокси Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Необязательно: путь к собранному интерфейсу, если он не в frontend/dist.
# FRONTEND_DIST=/absolute/path/to/dist
